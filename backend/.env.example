# Copie para `.env` e ajuste. Nunca versione o `.env`.
# Os valores abaixo são apenas para desenvolvimento local, não são credenciais reais.

# --- Django ---
DJANGO_DEBUG=true
# Obrigatória quando DJANGO_DEBUG=false. Gere uma chave própria para qualquer ambiente compartilhado.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Origens permitidas via CORS, separadas por vírgula (sem curinga).
# Vazio = nenhuma origem de navegador. O app Flutter nativo não depende de CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limite por credencial de integração (formato DRF: N/sec, N/min, N/hour, N/day).
INTEGRATION_RATE_LIMIT=60/min

# --- Roteamento (OSRM público de demonstração; não usar em produção sem instância própria) ---
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10
ROUTING_CACHE_TTL=120
ROUTING_RATE_LIMIT=30/min
OSRM_MIN_REQUEST_INTERVAL=1.0
OSRM_OUTBOUND_LOCK_TTL=30

# --- Demonstração acadêmica (apps.demo; veja docs/demo-academica.md) ---
# Desligado por padrão. Só funciona com DJANGO_DEBUG=true: com DJANGO_DEBUG=false, DEMO_MODE=true
# impede a aplicação de iniciar. Liga os comandos de simulação e a rota de ônibus SIMULADA.
DEMO_MODE=false
# Habilita a atualização automática das UPAs
DEMO_AUTO_UPDATE=false

# Intervalo entre atualizações (segundos)
DEMO_UPDATE_INTERVAL=60
# Idade (minutos) a partir da qual show_demo_status chama uma leitura de desatualizada.
# Mantenha igual a OPERATIONAL_MAX_AGE_MINUTES do app Flutter (padrão 30).
DEMO_STALE_AFTER_MINUTES=30
# Atualização automática (serviço `simulator` do Compose / `manage.py run_demo_auto_update`).
# Desligada por padrão; só funciona com DEMO_MODE=true e DJANGO_DEBUG=true. A cada
# DEMO_UPDATE_INTERVAL segundos (mínimo 5) grava cenários `random` nas UPAs de cenário,
# preservando as UPAs sem dados, desatualizada e com falha de atualização.
DEMO_AUTO_UPDATE=false
DEMO_UPDATE_INTERVAL=60

# --- PostgreSQL ---
POSTGRES_DB=rotasaude
POSTGRES_USER=rotasaude
POSTGRES_PASSWORD=dev-only-change-me
# Fora do Compose use `localhost`. O compose.yaml sobrescreve para `db`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Compose (opcional) ---
# Ambiente de demonstração (./scripts/start-demo.sh): use POSTGRES_HOST_PORT=55434, API_PORT=8001 e
# COMPOSE_PROJECT_NAME=rotasaude_demo (veja docs/demo-academica.md). POSTGRES_PASSWORD só vale na
# primeira inicialização do volume do Postgres; depois, trocá-la no .env não altera o banco.
# Interface em que a API é publicada no host. Use 0.0.0.0 para testar em aparelho físico na mesma rede.
API_BIND=127.0.0.1
API_PORT=8000
POSTGRES_HOST_PORT=5432
